# Copiar a .env y completar. Los puertos del host evitan los defaults (5432, 8000, 3000, 9090)
# para convivir con otros stacks locales.
DB_USER=kleva
DB_PASSWORD=cambiar
DB_NAME=kleva_db
DB_HOST=localhost
DB_PORT=5433
SECRET_KEY=generar-con-python-c-import-secrets-print-secrets.token_urlsafe-32
CORS_ORIGINS=["http://localhost:5173","http://localhost:8080"]

# Emulación
DISPATCH_INTERVAL_SECONDS=5
# SIMULATION_SEED=42          # descomentar para una demo reproducible
ANSWER_RATE=0.65
RETRY_NO_ANSWER_MINUTES=30
REFUSED_COOLDOWN_DAYS=7
PROMISE_GRACE_DAYS=1

# Puertos del host (docker compose)
BACKEND_PORT=8010
FRONTEND_PORT=8080
GRAFANA_PORT=3010
PROMETHEUS_PORT=9091
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin
